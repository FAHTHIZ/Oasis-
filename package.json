{
	"name": "oasis-agent",
	"version": "0.1.0",
	"description": "OASIS: a coding agent built on the pi engine, with verification gates, safety policy and memory as first-class extensions.",
	"type": "module",
	"license": "MIT",
	"author": "FAHTHIZ",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FAHTHIZ/Oasis-.git"
	},
	"bin": {
		"oasis": "bin/oasis.mjs"
	},
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"bin",
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"piConfig": {
		"name": "oasis",
		"configDir": ".oasis"
	},
	"scripts": {
		"build": "tsdown && node scripts/copy-pi-assets.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest run",
		"check": "npm run lint && npm run typecheck && npm test",
		"prepack": "npm run build"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.83",
		"@ast-grep/lang-go": "^0.0.6",
		"@ast-grep/lang-python": "^0.0.6",
		"@ast-grep/lang-rust": "^0.0.7",
		"@ast-grep/napi": "^0.51.2",
		"@earendil-works/pi-agent-core": "1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@earendil-works/pi-tui": "1.5.2",
		"@vscode/tree-sitter-wasm": "^0.3.1",
		"croner": "^9.1.0",
		"defuddle": "0.19.6",
		"diff": "9.0.0",
		"domhandler": "6.0.1",
		"grammy": "^1.46.0",
		"htmlparser2": "12.0.0",
		"ignore": "^7.0.14",
		"ipaddr.js": "2.5.0",
		"jsonc-parser": "^3.3.1",
		"linkedom": "0.18.15",
		"mammoth": "^1.13.0",
		"minimatch": "11.0.3",
		"minisearch": "^7.2.0",
		"pi-acp": "^0.0.34",
		"smol-toml": "^1.9.1",
		"typebox": "1.4.7",
		"unbash": "6.0.4",
		"unpdf": "^1.9.1",
		"vscode-jsonrpc": "^8.2.1",
		"wink-porter2-stemmer": "^2.0.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@types/node": "22.20.5",
		"tsdown": "0.23.7",
		"typescript": "5.9.3",
		"typescript-language-server": "^4.4.1",
		"vitest": "5.1.0"
	},
	"overrides": {
		"zod": "4.6.7"
	}
}
